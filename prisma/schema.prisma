generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ─── Empresas (multi-tenant) ──────────────────────────────────────────────────
// Fase 1 da migração multi-empresa: empresaId ainda opcional em todos os
// modelos abaixo (etapa aditiva) — será tornado obrigatório após o backfill
// dos dados existentes, EXCETO em Usuario (fica opcional para sempre, por
// causa do papel PLATAFORMA, que não pertence a nenhuma empresa). Campos de
// billing/plano e admin cross-empresa (além do PLATAFORMA) ficam
// deliberadamente fora de escopo por ora.

model Empresa {
  id              String   @id @default(cuid())
  nome            String
  slug            String   @unique
  logoUrl         String?
  cep             String?
  logradouro      String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  estado          String?
  codigoIbge      String?
  ativo           Boolean  @default(true)
  whatsappPausado Boolean  @default(false)
  emailPausado    Boolean  @default(false)
  criadoEm        DateTime @default(now())

  // Credenciais de envio de WhatsApp, uma conta própria por empresa (sem
  // fallback para variável de ambiente global — ver commit que reabriu a
  // "Fase 3", cancelada anteriormente). Preenchido pela plataforma na tela
  // de edição de empresa.
  fonnteToken          String?
  evolutionApiUrl      String?
  evolutionApiKey      String?
  evolutionApiInstance String?

  // Marca se já foi enviado o e-mail de alerta (pra plataforma) avisando que
  // o device do Fonnte desta empresa caiu — evita reenviar o alerta a cada
  // execução do cron enquanto a desconexão persiste. Zerado automaticamente
  // assim que o device volta a ficar conectado (ver verificarStatusFonnte em
  // src/lib/notificacoes.ts).
  fonnteAlertaEnviado Boolean @default(false)

  // Credenciais de SMTP para envio de e-mail, mesmo padrão do WhatsApp acima:
  // uma conta própria por empresa, sem fallback pra variável de ambiente
  // global. emailFrom cai pra emailUser se não preenchido, igual ao comportamento
  // anterior com EMAIL_FROM/EMAIL_USER.
  emailHost String?
  emailPort String?
  emailUser String?
  emailPass String?
  emailFrom String?

  usuarios             Usuario[]
  professoras          Professora[]
  materias             Materia[]
  escolas              Escola[]
  unidades             Unidade[]
  alunos               Aluno[]
  aulas                AgendaAula[]
  avaliacoes           Avaliacao[]
  pagamentos           Pagamento[]
  conteudos            Conteudo[]
  notas                Nota[]
  notificacoesProva    NotificacaoProva[]
  notificacoesAula     NotificacaoAula[]
  notificacoesConteudo NotificacaoConteudo[]
  calendarios          CalendarioEscolar[]
  materiaisBiblioteca  MaterialBiblioteca[]
  metodosEnsino        MetodoEnsino[]
  tiposAvaliacao       TipoAvaliacao[]

  @@map("empresas")
}

// ─── Usuários e Autenticação ──────────────────────────────────────────────────

model Usuario {
  id               String    @id @default(cuid())
  empresaId        String?
  nome             String
  email            String
  senhaHash        String
  senhaTemporaria  Boolean   @default(false)
  resetToken       String?   @unique
  resetTokenExpira DateTime?
  perfil           Perfil    @default(PROFESSORA)
  ativo            Boolean   @default(true)
  foto             String?
  whatsapp         String?
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt

  empresa    Empresa?    @relation(fields: [empresaId], references: [id])
  professora Professora?

  @@unique([empresaId, email])
  @@index([empresaId])
  @@map("usuarios")
}

enum Perfil {
  SUPERADMIN
  PROFESSORA
  SUPERADMIN_PROFESSORA // administra a empresa e também dá aula, num único usuário
  AUXILIAR
  PLATAFORMA
}

// ─── Professoras ──────────────────────────────────────────────────────────────

model Professora {
  id              String   @id @default(cuid())
  empresaId       String
  usuarioId       String   @unique
  telefone        String?
  disponibilidade Json?
  criadoEm        DateTime @default(now())

  empresa      Empresa             @relation(fields: [empresaId], references: [id])
  usuario      Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  materias     ProfessoraMateria[]
  alunos       Aluno[]
  notificacoes NotificacaoProva[]
  aulas        AgendaAula[]

  @@index([empresaId])
  @@map("professoras")
}

// ─── Disciplinas ──────────────────────────────────────────────────────────────

model Materia {
  id        String @id @default(cuid())
  empresaId String
  nome      String
  cor       String @default("#6366f1")

  empresa                     Empresa                     @relation(fields: [empresaId], references: [id])
  professoras                 ProfessoraMateria[]
  alunoMaterias               AlunoMateria[]
  avaliacoes                  Avaliacao[]
  notas                       Nota[]
  conteudos                   Conteudo[]
  aulas                       AgendaAula[]
  aulasMaterias               AgendaAulaMateria[]
  materiaisBiblioteca         MaterialBiblioteca[]
  conteudoMaterias            ConteudoMateria[]
  materiaisBibliotecaMaterias MaterialBibliotecaMateria[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("materias")
}

model ProfessoraMateria {
  professoraId String
  materiaId    String

  professora Professora @relation(fields: [professoraId], references: [id], onDelete: Cascade)
  materia    Materia    @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@id([professoraId, materiaId])
  @@map("professora_materias")
}

// ─── Métodos de Ensino ──────────────────────────────────────────────────────────

model MetodoEnsino {
  id        String @id @default(cuid())
  empresaId String
  nome      String

  empresa             Empresa              @relation(fields: [empresaId], references: [id])
  materiaisBiblioteca MaterialBiblioteca[]
  escolas             Escola[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("metodos_ensino")
}

// Lista editável de tipos de avaliação (Prova 1, Trabalho, etc.) usada como
// opção no campo "Tipo" do Calendário de Provas. Sem relação direta com
// Avaliacao — o valor escolhido é copiado como texto pra Avaliacao.nome no
// momento da criação (mesmo padrão que já existia com a lista fixa). Editar
// o nome aqui não muda avaliações já criadas; excluir é bloqueado (na API)
// se já existir alguma avaliação usando esse tipo (checado por nome).
model TipoAvaliacao {
  id        String @id @default(cuid())
  empresaId String
  nome      String

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("tipos_avaliacao")
}

// ─── Escolas e Unidades ───────────────────────────────────────────────────────

model Escola {
  id                   String    @id @default(cuid())
  empresaId            String
  nome                 String
  rede                 String?
  metodoId             String?
  periodoAvaliacao     String?
  periodoLetivo1Inicio DateTime?
  periodoLetivo1Fim    DateTime?
  periodoLetivo2Inicio DateTime?
  periodoLetivo2Fim    DateTime?
  criadoEm             DateTime  @default(now())

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  metodoEnsino MetodoEnsino? @relation(fields: [metodoId], references: [id])
  unidades     Unidade[]

  @@index([empresaId])
  @@index([metodoId])
  @@map("escolas")
}

model Unidade {
  id        String   @id @default(cuid())
  empresaId String
  escolaId  String
  nome      String
  endereco  String?
  bairro    String?
  cidade    String?
  estado    String?
  cep       String?
  telefone  String?
  diretor   String?
  turno     String?
  criadoEm  DateTime @default(now())

  empresa     Empresa             @relation(fields: [empresaId], references: [id])
  escola      Escola              @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  alunos      Aluno[]
  calendarios CalendarioEscolar[]
  avaliacoes  Avaliacao[]

  @@index([empresaId])
  @@index([escolaId])
  @@map("unidades")
}

// ─── Calendário Escolar ───────────────────────────────────────────────────────

model CalendarioEscolar {
  id         String     @id @default(cuid())
  empresaId  String
  unidadeId  String
  ano        Int
  titulo     String
  dataInicio DateTime
  dataFim    DateTime
  tipo       TipoEvento @default(AULA)
  descricao  String?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([unidadeId])
  @@map("calendario_escolar")
}

enum TipoEvento {
  AULA
  RECESSO
  FERIADO
  EVENTO
  REUNIAO
}

// ─── Avaliações / Calendário de Provas ───────────────────────────────────────

model Avaliacao {
  id         String   @id @default(cuid())
  empresaId  String
  unidadeId  String
  materiaId  String?
  serie      String
  nome       String
  data       DateTime
  peso       Float    @default(1.0)
  notaMax    Float    @default(10.0)
  periodo    String?
  observacao String?
  criadoEm   DateTime @default(now())

  empresa      Empresa            @relation(fields: [empresaId], references: [id])
  unidade      Unidade            @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  materia      Materia?           @relation(fields: [materiaId], references: [id])
  notas        Nota[]
  notificacoes NotificacaoProva[]

  @@index([empresaId])
  @@index([unidadeId])
  @@index([materiaId])
  @@map("avaliacoes")
}

// ─── Notificações WhatsApp + E-mail ──────────────────────────────────────────

model NotificacaoProva {
  id           String   @id @default(cuid())
  empresaId    String
  professoraId String
  avaliacaoId  String
  diasAntes    Int // quantos dias faltam para a prova quando enviou
  // WhatsApp
  enviada      Boolean  @default(false)
  whatsapp     String? // número usado no envio (opcional agora)
  // E-mail
  emailEnviado Boolean  @default(false)
  email        String? // endereço usado no envio
  criadoEm     DateTime @default(now())

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  professora Professora @relation(fields: [professoraId], references: [id], onDelete: Cascade)
  avaliacao  Avaliacao  @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@unique([professoraId, avaliacaoId, diasAntes])
  @@index([empresaId])
  @@map("notificacoes_prova")
}

// ─── Alunos ───────────────────────────────────────────────────────────────────

model Aluno {
  id                  String      @id @default(cuid())
  empresaId           String
  professoraId        String?
  unidadeId           String
  nome                String
  dataNascimento      DateTime?
  fotoUrl             String?
  serie               String
  turma               String?
  responsavel         String?
  telefoneResponsavel String?
  emailResponsavel    String?
  rua                 String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  estado              String?
  cep                 String?
  observacoes         String?
  status              StatusAluno @default(ATIVO)
  // ── Configuração de cobrança ──────────────────────────────────────
  tipoCobranca        String? // MENSAL | QUINZENAL | SEMANAL | POR_AULA
  valorCobranca       Decimal?    @db.Decimal(10, 2) // valor por parcela / por aula
  diaPagamento        Int? // dia do mês (MENSAL = venc.; QUINZENAL = 1ª parcela)
  diaPagamento2       Int? // 2ª parcela (apenas QUINZENAL)
  diaSemana           Int? // legado — mantido para retrocompat
  horaAula            String? // legado — mantido para retrocompat
  agendaSemanal       Json? // [{ diaSemana: 1, horaAula: "14:00" }, ...]
  diaSemanaCobranca   Int? // 0=Dom … 6=Sáb (vencimento semanal — SEMANAL)
  // ── Período contratual ───────────────────────────────────────────────
  dataInicioContrato  DateTime?
  dataFimContrato     DateTime?
  criadoEm            DateTime    @default(now())
  atualizadoEm        DateTime    @updatedAt

  empresa    Empresa        @relation(fields: [empresaId], references: [id])
  professora Professora?    @relation(fields: [professoraId], references: [id], onDelete: SetNull)
  unidade    Unidade        @relation(fields: [unidadeId], references: [id])
  materias   AlunoMateria[]
  notas      Nota[]
  conteudos  Conteudo[]
  pagamentos Pagamento[]
  aulas      AgendaAula[]

  @@index([empresaId])
  @@index([professoraId])
  @@index([unidadeId])
  @@map("alunos")
}

enum StatusAluno {
  ATIVO
  PAUSADO
  ENCERRADO
}

model AlunoMateria {
  alunoId   String
  materiaId String

  aluno   Aluno   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  materia Materia @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@id([alunoId, materiaId])
  @@map("aluno_materias")
}

// ─── Notas ────────────────────────────────────────────────────────────────────

model Nota {
  id          String   @id @default(cuid())
  empresaId   String
  alunoId     String
  avaliacaoId String
  materiaId   String
  valor       Float
  observacao  String?
  criadoEm    DateTime @default(now())

  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  aluno     Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  avaliacao Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  materia   Materia   @relation(fields: [materiaId], references: [id])

  @@unique([alunoId, avaliacaoId, materiaId])
  @@index([empresaId])
  @@map("notas")
}

// ─── Pagamentos ───────────────────────────────────────────────────────────────

model Pagamento {
  id              String    @id @default(cuid())
  empresaId       String
  alunoId         String
  mes             Int // 1-12
  ano             Int
  parcela         Int       @default(1) // sequencial por aluno/mes/ano — cada pagamento automático cobre exatamente 1 aula (ver PagamentoAula); tipoCobranca só define dataVencimento, nunca agrupa aulas
  dataVencimento  DateTime // data exata do vencimento
  valorCobrado    Decimal   @db.Decimal(10, 2)
  quantidadeAulas Int? // pagamentos automáticos: sempre 1. Pagamentos manuais podem ter outro valor.
  pago            Boolean   @default(false)
  dataPagamento   DateTime?
  observacao      String?
  emailTipo       String? // "lembrete" | "atraso" | "recibo" — último e-mail enviado
  emailEnviadoEm  DateTime? // data/hora do último envio
  origemManual    Boolean   @default(false) // true = criado manualmente pelo admin
  origemReposicao Boolean   @default(false) // true = criado ao excluir uma aula marcada como "será reposta"
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  empresa Empresa         @relation(fields: [empresaId], references: [id])
  aluno   Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  aulas   PagamentoAula[]

  @@unique([alunoId, mes, ano, parcela])
  @@index([empresaId])
  @@map("pagamentos")
}

model PagamentoAula {
  pagamentoId  String
  agendaAulaId String

  pagamento  Pagamento  @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)
  agendaAula AgendaAula @relation(fields: [agendaAulaId], references: [id], onDelete: Cascade)

  @@id([pagamentoId, agendaAulaId])
  @@map("pagamento_aulas")
}

// ─── Conteúdos Didáticos ──────────────────────────────────────────────────────

model Conteudo {
  id         String   @id @default(cuid())
  empresaId  String
  alunoId    String
  materiaId  String?
  aulaId     String?  @unique // vínculo exato com a Aula Agendada (evita ambiguidade quando há +1 aula no mesmo dia)
  data       DateTime
  topico     String
  descricao  String?
  arquivoUrl String?
  planejado  Boolean  @default(false)
  criadoEm   DateTime @default(now())

  empresa     Empresa              @relation(fields: [empresaId], references: [id])
  aluno       Aluno                @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  materia     Materia?             @relation(fields: [materiaId], references: [id])
  aula        AgendaAula?          @relation(fields: [aulaId], references: [id], onDelete: SetNull)
  materias    ConteudoMateria[]
  notificacao NotificacaoConteudo?

  @@index([empresaId])
  @@index([alunoId])
  @@index([materiaId])
  @@map("conteudos")
}

// Vínculo N:N de matérias por Conteúdo — permite marcar várias matérias num
// mesmo registro. `Conteudo.materiaId` continua existindo como "matéria
// primária" (a primeira escolhida), só pra compatibilidade de exibição; esta
// tabela é a fonte de verdade pra "quais matérias" (mesmo padrão de
// AgendaAulaMateria). Conjunto vazio = "todas as matérias" (coringa).
model ConteudoMateria {
  conteudoId String
  materiaId  String

  conteudo Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  materia  Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@id([conteudoId, materiaId])
  @@map("conteudo_materias")
}

// ─── Biblioteca de Materiais ────────────────────────────────────────────────

model MaterialBiblioteca {
  id          String   @id @default(cuid())
  empresaId   String
  titulo      String
  descricao   String?
  metodoTexto String?  @map("metodo") // temporário — removido após backfill pra metodoId
  metodoId    String?
  serie       String?
  materiaId   String?
  arquivoUrl  String
  arquivoNome String?
  criadoEm    DateTime @default(now())

  empresa      Empresa                     @relation(fields: [empresaId], references: [id])
  materia      Materia?                    @relation(fields: [materiaId], references: [id])
  metodoEnsino MetodoEnsino?               @relation(fields: [metodoId], references: [id])
  materias     MaterialBibliotecaMateria[]

  @@index([empresaId])
  @@index([materiaId])
  @@index([metodoId])
  @@map("biblioteca_materiais")
}

// Vínculo N:N de matérias por Material da Biblioteca — mesmo padrão de
// ConteudoMateria. `MaterialBiblioteca.materiaId` continua sendo a "matéria
// primária" pra compatibilidade de exibição.
model MaterialBibliotecaMateria {
  materialId String
  materiaId  String

  material MaterialBiblioteca @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materia  Materia            @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@id([materialId, materiaId])
  @@map("biblioteca_material_materias")
}

// ─── Agenda de Aulas ──────────────────────────────────────────────────────────

model AgendaAula {
  id           String     @id @default(cuid())
  empresaId    String
  professoraId String
  alunoId      String
  materiaId    String?
  data         DateTime
  horaInicio   String? // "14:00"
  horaFim      String? // "15:00"
  status       StatusAula @default(AGENDADA)
  reposicao    Boolean    @default(false) // aula de reposição cuja cobrança já foi feita na aula original excluída
  observacao   String?
  criadoEm     DateTime   @default(now())

  empresa     Empresa             @relation(fields: [empresaId], references: [id])
  professora  Professora          @relation(fields: [professoraId], references: [id], onDelete: Cascade)
  aluno       Aluno               @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  materia     Materia?            @relation(fields: [materiaId], references: [id])
  materias    AgendaAulaMateria[]
  pagamentos  PagamentoAula[]
  notificacao NotificacaoAula?
  conteudo    Conteudo?

  @@index([empresaId])
  @@index([professoraId])
  @@index([alunoId])
  @@index([materiaId])
  @@map("agenda_aulas")
}

// Matérias adicionais vinculadas a uma mesma aula (geração automática traz
// todas as matérias parametrizadas no cadastro do aluno em um único registro)
model AgendaAulaMateria {
  id           String @id @default(cuid())
  agendaAulaId String
  materiaId    String

  agendaAula AgendaAula @relation(fields: [agendaAulaId], references: [id], onDelete: Cascade)
  materia    Materia    @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@unique([agendaAulaId, materiaId])
  @@map("agenda_aula_materias")
}

enum StatusAula {
  AGENDADA
  REALIZADA
  CANCELADA
  FALTA_ALUNO
  FALTA_PROFESSOR
}

// ─── Notificações de Aula para Responsáveis ───────────────────────────────────

model NotificacaoAula {
  id           String   @id @default(cuid())
  empresaId    String
  agendaAulaId String   @unique
  // WhatsApp
  enviada      Boolean  @default(false)
  whatsapp     String?
  // E-mail — usado quando a empresa não tem Fonnte nem Evolution
  // configurados (ver enviarEmailAula em src/lib/email.ts).
  emailEnviado Boolean  @default(false)
  email        String?
  criadoEm     DateTime @default(now())

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  agendaAula AgendaAula @relation(fields: [agendaAulaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("notificacoes_aula")
}

// ─── Notificações de Conteúdo Ministrado para Responsáveis ───────────────────
// Só canal e-mail (reusa Empresa.emailPausado pro disparo automático — reenvio
// manual ignora a pausa, mesmo padrão de NotificacaoAula).
model NotificacaoConteudo {
  id         String   @id @default(cuid())
  empresaId  String
  conteudoId String   @unique
  enviada    Boolean  @default(false)
  email      String?
  criadoEm   DateTime @default(now())

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  conteudo Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("notificacoes_conteudo")
}
